# ==========================================
# AI Study Companion - Backend Environment Configuration
# ==========================================

# Application
PROJECT_NAME="AI Study Companion"
FRONTEND_URL="http://localhost:5173"

# Database Configuration
# Defaults to SQLite; seamlessly points to PostgreSQL in production
DATABASE_URL="sqlite:///./ai_study_companion.db"

# Security & JWT Authentication
JWT_SECRET="dev_super_secret_key_change_in_production_ai_study_companion"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported providers: "auto", "openai", "gemini"
AI_PROVIDER="auto"

# OpenAI Configuration (Production AI Tutor & Vision)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

# Google Gemini / Fallback AI Configuration
AI_API_KEY=""
AI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"
